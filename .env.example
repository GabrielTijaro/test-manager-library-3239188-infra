# Copy to .env and fill in. The real .env is never committed (Article IX).

# --- PostgreSQL (starts empty) ---
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=change-me
DB_PORT=5432

# --- API ---
# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# Long random string, e.g.: openssl rand -hex 32
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
API_PORT=8000

# --- Frontend ---
APP_PORT=5173
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# --- Where the sibling repositories live (defaults assume they sit next to this one) ---
# API_CONTEXT=../test-manager-library-3239188-api
# APP_CONTEXT=../test-manager-library-3239188-app
